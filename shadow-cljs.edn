;; shadow-cljs build config.
;; Owners never need to touch this file. Stock and site info live in
;; stock.edn and site.edn.
{:source-paths ["src"]

 :dependencies [[reagent "2.0.1"]]

 ;; Dev server: `npm run dev`, then open http://localhost:8080
 :dev-http {8080 ["public" "static"]}

 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   ;; Relative on purpose, so the site works from / or from /repo-name/.
   :asset-path "js"
   :modules {:main {:init-fn couplea.core/init}}

   ;; DISCORD_WEBHOOK_URL is read from the environment at build time.
   ;; NOTE: it ends up inside the published JavaScript. See README.md.
   :closure-defines
   {couplea.order/WEBHOOK_URL #shadow/env ["DISCORD_WEBHOOK_URL" :default ""]}

   ;; Writes public/index.html (from static/index.html) and syncs images/.
   :build-hooks [(couplea.build/dev-files)]

   :devtools {:watch-dir "static"}}}}
